# Dependencies and tooling caches
/node_modules/
*.tsbuildinfo
__pycache__/

# Generated application and test output
/docdrop
/build/
/coverage/
/test-results/
/playwright-report/
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Private configuration, certificates and uploaded data
.env*
!.env.example
*.pem
/.local/
/data/
.docdrop-uploads/

# Legacy generated caches: never reintroduce them after switching old branches
/.next/
/out/
.vercel/
next-env.d.ts

# Editor and package-manager noise
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
