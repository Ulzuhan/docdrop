[Unit]
Description=DocDrop — file sharing with temporary links
Documentation=file:///opt/docdrop/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── Identity ─────────────────────────────────────────────────────────
# A dedicated user that is NOT a member of the docker group. This is what stops a
# compromise of the application from escalating to root: on a typical single-user
# box the login account often is in that group, and from there
# `docker run -v /:/host` hands over the whole machine.
User=docdrop
Group=docdrop

WorkingDirectory=/opt/docdrop
# The dash makes it optional: without credentials the service starts fail-closed and
# lets nobody sign in. There is no open mode.
EnvironmentFile=-/etc/docdrop.env
Environment=NODE_ENV=production
Environment=PORT=3010
# Listens on loopback only: the sole way in is a reverse proxy or a tunnel.
Environment=HOSTNAME=127.0.0.1
Environment=DOCDROP_DATA_DIR=/var/lib/docdrop

# start.js raises the HTTP server's requestTimeout before handing control to Next:
# Node's default (5 min) cuts large uploads off mid-transfer. Tune it with
# DOCDROP_REQUEST_TIMEOUT_MS.
ExecStart=/usr/local/bin/node start.js
Restart=on-failure
RestartSec=5s

# ── Filesystem isolation ─────────────────────────────────────────────
# Everything read-only except the data directory. It cannot even rewrite its own
# code in /opt/docdrop, which is owned by root.
ProtectSystem=strict
ReadWritePaths=/var/lib/docdrop
# No access to /home: that is where SSH keys, tokens and other projects live.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

# ── Privileges ───────────────────────────────────────────────────────
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateUsers=yes

# ── Kernel ───────────────────────────────────────────────────────────
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes

# ── System calls ─────────────────────────────────────────────────────
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot
# Note: MemoryDenyWriteExecute is deliberately not enabled — V8's JIT needs
# executable pages and the process would not start.

# ── Network ──────────────────────────────────────────────────────────
# IPv4/IPv6/Unix only; no raw sockets, no netlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# (IPAddressDeny is not used: it silently does nothing on a systemd built without
# BPF_FRAMEWORK. Network containment comes from listening on loopback only.)

# ── Resources: keep abuse from taking the machine down ───────────────
MemoryMax=1G
TasksMax=256
LimitNOFILE=8192
LimitCORE=0

[Install]
WantedBy=multi-user.target
