[Unit]
Description=DocDrop — file sharing with temporary links
Documentation=file:///opt/docdrop/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── Identity ─────────────────────────────────────────────────────────
# A dedicated user that is NOT a member of the docker group. This is what stops a
# compromise of the application from escalating to root: on a typical single-user
# box the login account often is in that group, and from there
# `docker run -v /:/host` hands over the whole machine.
User=docdrop
Group=docdrop

WorkingDirectory=/opt/docdrop
# The dash makes it optional: without credentials the service starts fail-closed and
# lets nobody sign in. There is no open mode.
EnvironmentFile=-/etc/docdrop.env
Environment=PORT=3010
# Listens on loopback only: the sole way in is a reverse proxy or a tunnel.
Environment=HOSTNAME=127.0.0.1
Environment=DOCDROP_DATA_DIR=/var/lib/docdrop

# Un solo binario: la interfaz va embebida y no hay Node que arrancar. El plazo
# largo por petición —lo que permite que una subida de gigas sea UNA petición de
# horas— lo pone el propio binario; se ajusta con DOCDROP_REQUEST_TIMEOUT_MS.
ExecStart=/opt/docdrop/docdrop
Restart=on-failure
RestartSec=5s

# El presupuesto de parada, alineado con el del binario (8 s por defecto,
# DOCDROP_SHUTDOWN_MS). Al parar se cierra la admisión y las transferencias en
# curso se CORTAN de forma controlada: son reanudables, y esperar a una subida
# de varios gigas no cabe en ninguna ventana de parada razonable.
TimeoutStopSec=10

# ── Filesystem isolation ─────────────────────────────────────────────
# Everything read-only except the data directory. It cannot even rewrite its own
# code in /opt/docdrop, which is owned by root.
ProtectSystem=strict
ReadWritePaths=/var/lib/docdrop
# No access to /home: that is where SSH keys, tokens and other projects live.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

# ── Privileges ───────────────────────────────────────────────────────
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateUsers=yes

# ── Kernel ───────────────────────────────────────────────────────────
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes

# ── System calls ─────────────────────────────────────────────────────
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot
# MemoryDenyWriteExecute: con Node estaba descartado porque el JIT de V8 necesita
# páginas ejecutables. Con el binario de Go ya no hay JIT y en principio podría
# activarse. Se deja apagado a propósito: no se ha probado en esta máquina, y una
# protección sin probar que impide arrancar es peor que no tenerla.
# MemoryDenyWriteExecute=yes

# ── Network ──────────────────────────────────────────────────────────
# IPv4/IPv6/Unix only; no raw sockets, no netlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# (IPAddressDeny is not used: it silently does nothing on a systemd built without
# BPF_FRAMEWORK. Network containment comes from listening on loopback only.)

# ── Resources: keep abuse from taking the machine down ───────────────
MemoryMax=1G
TasksMax=256
LimitNOFILE=8192
LimitCORE=0

[Install]
WantedBy=multi-user.target
