# DocDrop configuration. Storage and timeout variables are optional; identity variables are required; these are the defaults.
# Copy to .env for Compose, or use your service manager's environment file.
# The binary does not load env files automatically. For local development export
# trusted configuration first: set -a; source .env; set +a; npm run dev.

# PORT=3010
# DOCDROP_DATA_DIR=.docdrop-uploads

# Storage limits (bytes)
# DOCDROP_MAX_FILE_BYTES=10737418240    # 10 GB per file
# DOCDROP_MAX_TOTAL_BYTES=21474836480   # 20 GB total
# DOCDROP_CHUNK_BYTES=33554432          # 32 MiB per chunk

# Duración máxima de una petición. Una subida grande es UNA sola petición, así
# que el plazo tiene que dar para horas; el servidor no pone plazo global de
# escritura, que cortaría las descargas largas por la mitad.
# DOCDROP_REQUEST_TIMEOUT_MS=43200000
# DOCDROP_HEADERS_TIMEOUT_MS=60000

# Presupuesto total de parada. Cabe dentro de los 10 s que concede Docker por
# defecto. Al parar se cierra la admisión y las transferencias en curso se
# CORTAN de forma controlada: son reanudables, y esperar a una subida de gigas
# no cabe en ninguna ventana de parada razonable. Si se alarga
# `stop_grace_period`, alargar también esto.
# DOCDROP_SHUTDOWN_MS=8000

# Cookies sin `Secure`, para desarrollo por HTTP. En cualquier otro sitio, NO:
# una cookie de sesión viajando en claro es la sesión regalada.
# DOCDROP_INSECURE_COOKIES=1

# OIDC upstream request timeout (milliseconds)
# DOCDROP_OIDC_TIMEOUT_MS=10000

# Signed-session lifetime in hours; clamped by the server to 1..24
# DOCDROP_SESSION_TTL_HOURS=12

# ─── Identidad ──────────────────────────────────────────────────────────
# El modo de contraseña local ya no existe: se sustituyó por OIDC y el script
# `set-password` se retiró con él. Esta sección lo documentaba todavía, así que
# mandaba a ejecutar un comando que ya no está.
#
# Sin `SESSION_SECRET` y sin cliente OIDC, la aplicación no deja entrar a nadie.

# Firma las cookies de sesión. Genérala con:
#   openssl rand -hex 32
DOCDROP_SESSION_SECRET=

# Credenciales del cliente, tal como las da el proveedor.
DOCDROP_OIDC_CLIENT_ID=
DOCDROP_OIDC_CLIENT_SECRET=

# Tiene que coincidir exactamente con la registrada en el proveedor.
DOCDROP_OIDC_REDIRECT_URI=https://ejemplo.tudominio.com/api/auth/callback

# EL EMISOR es lo único que hay que decir del proveedor: authorize, token,
# userinfo, end-session y las claves se leen de su propio
# `<emisor>/.well-known/openid-configuration`. Así esto vale igual con
# cualquier proveedor OIDC, sin rutas de nadie escritas en el código.
DOCDROP_OIDC_ISSUER=https://auth.tudominio.com/emisor-de-docdrop/

# La dirección que usa ESTE SERVIDOR para hablar con el proveedor, si es distinta
# de la pública: si corre en la misma máquina, apuntarla a loopback evita salir a
# internet. Sin poner, se usa el origen del emisor.
# Inside Docker, use the provider's network name, not the host loopback.
# DOCDROP_OIDC_INTERNAL_BASE=http://idp:9000

# Nombre público con el que se comprueba el origen. Sin poner se usa el Host que
# llega, que es lo correcto detrás de un túnel que lo conserva. Sólo hace falta si
# el proxy lo reescribe con un nombre interno.
# DOCDROP_PUBLIC_HOST=docdrop.example.com

# A dónde manda el botón "Request an account" de la portada — el flujo de alta de
# TU proveedor, si tiene autoservicio. Sin poner, el botón no existe y la portada
# solo ofrece iniciar sesión.
# DOCDROP_ENROLL_URL=https://auth.tudominio.com/ruta-de-alta-de-tu-proveedor/
# La página de la cuenta en tu proveedor: correo, contraseña, segundo factor, sesiones.
# Nada de eso lo lleva esta aplicación. Sin la variable, el menú de cuenta no enlaza a
# ningún sitio. La ruta es de cada proveedor: cópiala entera del suyo.
#DOCDROP_ACCOUNT_URL=https://auth.tudominio.com/ruta-de-cuenta-de-tu-proveedor/
