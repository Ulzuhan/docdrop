{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Madrid",
  "schedule": [
    "before 8am on monday"
  ],
  "labels": [
    "dependencias"
  ],
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "menores y parches"
    },
    {
      "description": "Respect the major required by each minimatch consumer.",
      "matchPackageNames": [
        "brace-expansion"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "seguridad"
    ],
    "schedule": [
      "at any time"
    ]
  }
}
