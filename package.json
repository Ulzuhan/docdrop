{
  "name": "docdrop",
  "version": "3.1.0",
  "description": "Self-hosted file sharing with expiring links: resumable chunked uploads for multi-GB files, previews, and streamed ZIP downloads.",
  "license": "MIT",
  "author": "Ulzuhan (https://github.com/Ulzuhan)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ulzuhan/docdrop.git"
  },
  "homepage": "https://github.com/Ulzuhan/docdrop#readme",
  "bugs": {
    "url": "https://github.com/Ulzuhan/docdrop/issues"
  },
  "keywords": [
    "file-sharing",
    "self-hosted",
    "golang",
    "chunked-upload",
    "resumable-upload",
    "pwa",
    "zip-streaming",
    "react"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && bash scripts/dev.sh",
    "build": "npm run build:web && go build -trimpath -o docdrop ./cmd/docdrop",
    "build:web": "vite build",
    "start": "./docdrop",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:go && npm run test:http && npm run test:backchannel",
    "test:unit": "vitest run",
    "test:go": "go test -race ./cmd/... ./internal/...",
    "test:http": "bash scripts/run-suites.sh",
    "test:backchannel": "bash scripts/test-backchannel.sh",
    "test:navegador": "bash scripts/test-navegador.sh",
    "test:compatibilidad": "bash scripts/test-compatibilidad.sh",
    "test:acceso": "bash scripts/run-suites.sh acceso",
    "test:ficheros": "bash scripts/run-suites.sh ficheros",
    "test:upload": "bash scripts/run-suites.sh upload",
    "test:e2ee": "bash scripts/run-suites.sh e2ee"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "nanoid": "6.0.1",
    "js-yaml": "^5.4.2",
    "brace-expansion@^1.1.7": "^1.1.21",
    "brace-expansion@^5.0.8": "^5.0.12"
  }
}
